# JARVIS Configuration Example
# Copy this file to .env and fill in your API keys

# AI Service Configuration
JARVIS_AI_PROVIDER=openai
JARVIS_AI_API_KEY=your_api_key_here

# Web Search Configuration
JARVIS_SEARCH_PROVIDER=google
JARVIS_SEARCH_API_KEY=your_api_key_here
JARVIS_SEARCH_ENGINE_ID=your_engine_id_here

# News API Configuration
JARVIS_NEWS_PROVIDER=newsapi
JARVIS_NEWS_API_KEY=your_api_key_here

# Voice Configuration
JARVIS_VOICE_LANGUAGE=en
JARVIS_VOICE_PROVIDER=google

# Memory Configuration
JARVIS_MEMORY_STORAGE=json
JARVIS_MEMORY_PATH=./memory/

# Debug Configuration
JARVIS_DEBUG=false
